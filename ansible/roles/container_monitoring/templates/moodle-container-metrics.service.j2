[Unit]
Description=Mesures en lecture seule des conteneurs Moodle
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 -B {{ container_monitoring_base_dir }}/collector.py --config {{ container_monitoring_config_dir }}/config.json --output {{ container_monitoring_textfile_dir }}/containers.prom
TimeoutStartSec=35
UMask=0022
Nice=10
MemoryMax=96M
CPUQuota=20%
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths={{ container_monitoring_state_dir }}
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
