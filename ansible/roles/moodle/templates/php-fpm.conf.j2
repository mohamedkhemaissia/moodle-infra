[www]
user = www-data
group = www-data
listen = 9000

pm = dynamic
pm.max_children = {{ moodle_fpm_max_children }}
pm.start_servers = 2
pm.min_spare_servers = 1
pm.max_spare_servers = 3
pm.max_requests = 500

catch_workers_output = yes
decorate_workers_output = no
security.limit_extensions = .php
request_terminate_timeout = 300s
{% if moodle_fpm_status_enabled | bool %}

; BEGIN PFE_APPLICATION_MONITORING
[www]
pm.status_path = {{ moodle_fpm_status_path }}
pm.status_listen = {{ moodle_fpm_status_port }}
; END PFE_APPLICATION_MONITORING
{% endif %}
