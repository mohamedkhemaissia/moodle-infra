global:
  scrape_interval: "{{ monitoring_scrape_interval }}"
  evaluation_interval: "{{ monitoring_scrape_interval }}"

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["127.0.0.1:{{ monitoring_prometheus_port }}"]

  - job_name: linux
    static_configs:
      - targets: ["127.0.0.1:{{ monitoring_node_exporter_port }}"]
        labels:
          environment: pfe
          service: moodle-host
