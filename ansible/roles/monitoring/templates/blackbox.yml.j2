modules:
  moodle_https:
    prober: http
    timeout: 5s
    http:
      method: GET
      valid_status_codes: [200]
      follow_redirects: true
      fail_if_not_ssl: {{ monitoring_probe_requires_tls | default(true) | bool | lower }}
      preferred_ip_protocol: ip4
      ip_protocol_fallback: false
{% if monitoring_moodle_probe_headers | length > 0 %}
      headers:
{% for name, value in monitoring_moodle_probe_headers.items() %}
        {{ name | to_json }}: {{ value | string | to_json }}
{% endfor %}
{% endif %}
      tls_config:
        ca_file: /etc/blackbox/moodle-ca.crt
        insecure_skip_verify: false
