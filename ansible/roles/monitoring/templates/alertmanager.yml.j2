global:
  resolve_timeout: 5m
{% if monitoring_alert_email_enabled | bool %}
  smtp_smarthost: {{ monitoring_alert_smtp_smarthost | to_json }}
  smtp_from: {{ monitoring_alert_smtp_from | to_json }}
  smtp_require_tls: true
{% if monitoring_alert_smtp_username | length > 0 %}
  smtp_auth_username: {{ monitoring_alert_smtp_username | to_json }}
  smtp_auth_password_file: /run/secrets/smtp-password
{% endif %}
{% endif %}

route:
  receiver: {{ 'moodle-email' if monitoring_alert_email_enabled | bool else 'local' }}
  group_by: [scope, alertname]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    - matchers: ['severity="critical"']
      group_wait: 10s
      group_interval: 1m
      repeat_interval: 1h

# Une collecte perdue n'est pas une preuve de panne du service.
inhibit_rules:
  - source_matchers: ['category="collection"']
    target_matchers: ['category=~"service|resource|container"']
    equal: [scope, environment, source_job]
  - source_matchers: ['alertname="MoodleLinuxCollectionUnavailable"']
    target_matchers: ['alertname="MoodleContainerCollectionUnavailable"']
    equal: [scope, environment]

receivers:
  - name: local
{% if monitoring_alert_email_enabled | bool %}
  - name: moodle-email
    email_configs:
      - to: {{ monitoring_alert_email_to | to_json }}
        send_resolved: true
{% endif %}
