services:
  prometheus:
    image: "{{ monitoring_prometheus_image }}"
    restart: unless-stopped
    network_mode: host
    command:
      - "--config.file=/etc/prometheus/prometheus.yml"
      - "--storage.tsdb.path=/prometheus"
      - "--storage.tsdb.retention.time={{ monitoring_retention_time }}"
      - "--storage.tsdb.retention.size={{ monitoring_retention_size }}"
      - "--web.listen-address=127.0.0.1:{{ monitoring_prometheus_port }}"
    volumes:
      - "{{ monitoring_base_dir }}/prometheus:/etc/prometheus:ro"
      - prometheus_data:/prometheus
    mem_limit: 512m
    cpus: "0.50"
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

{% if monitoring_alertmanager_enabled | bool %}
  alertmanager:
    image: "{{ monitoring_alertmanager_image }}"
    restart: unless-stopped
    network_mode: host
    user: "65534:65534"
    read_only: true
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    command:
      - "--config.file=/etc/alertmanager/alertmanager.yml"
      - "--storage.path=/alertmanager"
      - "--data.retention={{ monitoring_alertmanager_retention }}"
      - "--web.listen-address=127.0.0.1:{{ monitoring_alertmanager_port }}"
      - "--cluster.listen-address="
    volumes:
      - "{{ monitoring_base_dir }}/alertmanager:/etc/alertmanager:ro"
      - alertmanager_data:/alertmanager
{% if monitoring_alert_email_enabled | bool and monitoring_alert_smtp_username | length > 0 %}
      - "{{ monitoring_alert_smtp_password_source }}:/run/secrets/smtp-password:ro"
{% endif %}
    tmpfs: ["/tmp:rw,noexec,nosuid,size=8m"]
    mem_limit: 96m
    cpus: "0.25"
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
{% endif %}

  node-exporter:
    image: "{{ monitoring_node_exporter_image }}"
    restart: unless-stopped
    network_mode: host
    pid: host
    command:
      - "--path.rootfs=/host"
      - "--web.listen-address=127.0.0.1:{{ monitoring_node_exporter_port }}"
      - "--no-collector.timex"
{% if monitoring_container_metrics_enabled | bool %}
      - "--collector.textfile.directory=/container-metrics"
{% endif %}
    volumes:
      - "/:/host:ro,rslave"
{% if monitoring_container_metrics_enabled | bool %}
      - "{{ monitoring_container_textfile_dir }}:/container-metrics:ro"
{% endif %}
    mem_limit: 128m
    cpus: "0.25"
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

  blackbox:
    image: "{{ monitoring_blackbox_image }}"
    restart: unless-stopped
    network_mode: host
    command:
      - "--config.file=/etc/blackbox/blackbox.yml"
      - "--web.listen-address=127.0.0.1:{{ monitoring_blackbox_port }}"
    extra_hosts:
      - "{{ monitoring_moodle_hostname }}:{{ monitoring_moodle_target_ip }}"
    volumes:
      - "{{ monitoring_base_dir }}/blackbox:/etc/blackbox:ro"
    mem_limit: 128m
    cpus: "0.25"
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

volumes:
  prometheus_data:
{% if monitoring_alertmanager_enabled | bool %}
  alertmanager_data:
{% endif %}
