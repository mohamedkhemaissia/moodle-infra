[Unit]
Description=Sauvegarde complete Moodle vers Windows
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
ConditionPathExists=!{{ moodle_base_dir }}/backups/restoration-active

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/local/sbin/{{ moodle_compose_project }}-backup
{% if moodle_backup_retention_enabled | bool %}
ExecStartPost=/usr/local/sbin/{{ moodle_compose_project }}-retention apply
{% endif %}
TimeoutStartSec=0
TimeoutStopSec=300
KillMode=mixed
StandardOutput=append:/var/log/moodle/{{ moodle_compose_project }}-backup.log
StandardError=inherit
