services:
  api:
    image: {{ control_plane_image | to_json }}
    network_mode: host
    restart: unless-stopped
    command:
      - python
      - -m
      - uvicorn
      - app.main:app
      - --no-proxy-headers
      - --host
      - 127.0.0.1
      - --port
      - {{ control_plane_port | string | to_json }}
    environment:
      AUTH_ENABLED: {{ (pilotage_auth_activation.stat.exists | ternary('true', 'false')) | to_json }}
      POLICIES_ENABLED: {{ (pilotage_policy_activation.stat.exists | ternary('true', 'false')) | to_json }}
      RECOVERY_REQUESTS_ENABLED: {{ (control_plane_recovery_requests_enabled | bool | ternary('true', 'false')) | to_json }}
      RECOVERY_EXECUTION_ENABLED: {{ (control_plane_recovery_execution_enabled | bool) | ternary("true", "false") | to_json }}
{% if pilotage_auth_activation.stat.exists %}
      AUTH_ALLOWED_ORIGINS: {{ (control_plane_auth_origins | to_json) | to_json }}
      AUTH_COOKIE_SECURE: {{ (control_plane_auth_secure_cookie | bool | ternary('true', 'false')) | to_json }}
      AUTH_WORKER_HASH_FILE: {{ (pilotage_database_config_dir ~ '/worker-token.sha256') | to_json }}
{% endif %}
{% if pilotage_database_activation.stat.exists %}
      PILOTAGE_DATABASE_CONFIG: {{ (pilotage_database_config_dir ~ '/database.json') | to_json }}
{% endif %}
      PROMETHEUS_URL: {{ control_plane_prometheus_url | to_json }}
      APPLICATION_METRICS_ENABLED: {{ (control_plane_application_metrics_enabled | bool) | ternary('true', 'false') | to_json }}
      APPLICATION_PHP_POOL: {{ control_plane_application_php_pool | to_json }}
      APPLICATION_PG_DATABASE: {{ control_plane_application_pg_database | to_json }}
      MAX_SCRAPE_AGE_SECONDS: {{ control_plane_max_scrape_age_seconds | string | to_json }}
{% if control_plane_backup_status_enabled | bool %}
      BACKUP_STATUS_FILE: /var/lib/moodle-backup-status/status.json
{% endif %}
{% if control_plane_pilotage_backup_status_enabled | bool %}
      PILOTAGE_BACKUP_STATUS_FILE: /var/lib/moodle-backup-status/pilotage.json
{% endif %}
{% if control_plane_backup_catalog_enabled | bool %}
      BACKUP_CATALOG_FILE: /var/lib/moodle-backup-status/catalog.json
{% endif %}
      DECISIONS_ENABLED: {{ (control_plane_decisions_enabled | bool | ternary('true', 'false')) | to_json }}
{% if control_plane_forecasts_enabled | bool %}
      FORECASTS_DIR: /opt/forecasts
{% endif %}
{% if control_plane_anomalies_enabled | bool %}
      ANOMALIES_DIR: /opt/anomalies
{% endif %}
{% if control_plane_incidents_enabled | bool %}
      INCIDENTS_DIR: /var/lib/moodle-incidents
{% endif %}
{% if control_plane_diagnostics_enabled | bool %}
      DIAGNOSTICS_DIR: /var/lib/moodle-diagnostics
{% endif %}
{% if control_plane_remediation_enabled | bool %}
      REMEDIATION_DIR: /var/lib/moodle-remediation
{% endif %}
{% if pilotage_database_activation.stat.exists or control_plane_forecasts_enabled | bool or control_plane_anomalies_enabled | bool or control_plane_incidents_enabled | bool or control_plane_diagnostics_enabled | bool or control_plane_remediation_enabled | bool or control_plane_backup_status_enabled | bool %}
    volumes:
{% if control_plane_backup_status_enabled | bool %}
      - type: bind
        source: {{ control_plane_backup_status_dir | to_json }}
        target: /var/lib/moodle-backup-status
        read_only: true
{% endif %}
{% if pilotage_database_activation.stat.exists %}
      - type: bind
        source: {{ pilotage_database_config_dir | to_json }}
        target: {{ pilotage_database_config_dir | to_json }}
        read_only: true
{% endif %}
{% if control_plane_forecasts_enabled | bool %}
      - type: bind
        source: {{ control_plane_forecast_runtime_dir | to_json }}
        target: /opt/forecasts
        read_only: true
{% endif %}
{% if control_plane_anomalies_enabled | bool %}
      - type: bind
        source: {{ control_plane_anomaly_deployed_dir | to_json }}
        target: /opt/anomalies
        read_only: true
{% endif %}
{% if control_plane_incidents_enabled | bool %}
      - type: bind
        source: {{ control_plane_incident_data_dir | to_json }}
        target: /var/lib/moodle-incidents
        read_only: true
{% endif %}
{% if control_plane_diagnostics_enabled | bool %}
      - type: bind
        source: {{ control_plane_diagnostics_data_dir | to_json }}
        target: /var/lib/moodle-diagnostics
        read_only: true
{% endif %}
{% if control_plane_remediation_enabled | bool %}
      - type: bind
        source: {{ control_plane_remediation_data_dir | to_json }}
        target: /var/lib/moodle-remediation
        read_only: true
{% endif %}
{% endif %}
    read_only: true
    tmpfs:
      - /tmp:rw,noexec,nosuid,size=32m,mode=1777
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    mem_limit: {{ control_plane_memory_limit | to_json }}
    cpus: {{ control_plane_cpu_limit | to_json }}
    healthcheck:
      test:
        - CMD
        - python
        - -c
        - "import urllib.request; urllib.request.urlopen('http://127.0.0.1:{{ control_plane_port }}/api/v1/health', timeout=3).close()"
      interval: 15s
      timeout: 5s
      start_period: 10s
      retries: 3
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"

{% if control_plane_incidents_enabled | bool %}
  observer:
    image: {{ control_plane_image | to_json }}
    network_mode: host
    restart: unless-stopped
    init: true
    command:
      - python
      - -m
      - app.incident_observer
    environment:
{% if pilotage_database_activation.stat.exists %}
      PILOTAGE_DATABASE_CONFIG: {{ (pilotage_database_config_dir ~ '/database.json') | to_json }}
{% endif %}
      PROMETHEUS_URL: {{ control_plane_prometheus_url | to_json }}
      MAX_SCRAPE_AGE_SECONDS: {{ control_plane_max_scrape_age_seconds | string | to_json }}
      INCIDENTS_DIR: /var/lib/moodle-incidents
      APPLICATION_METRICS_ENABLED: {{ (control_plane_application_metrics_enabled | bool) | ternary('true', 'false') | to_json }}
{% if control_plane_anomalies_enabled | bool %}
      ANOMALIES_DIR: /opt/anomalies
{% endif %}
    volumes:
{% if pilotage_database_activation.stat.exists %}
      - type: bind
        source: {{ pilotage_database_config_dir | to_json }}
        target: {{ pilotage_database_config_dir | to_json }}
        read_only: true
{% endif %}
      - type: bind
        source: {{ control_plane_incident_data_dir | to_json }}
        target: /var/lib/moodle-incidents
        read_only: false
{% if control_plane_anomalies_enabled | bool %}
      - type: bind
        source: {{ control_plane_anomaly_deployed_dir | to_json }}
        target: /opt/anomalies
        read_only: true
{% endif %}
    read_only: true
    tmpfs:
      - /tmp:rw,noexec,nosuid,size=16m,mode=1777
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    mem_limit: {{ control_plane_incident_observer_memory_limit | to_json }}
    cpus: {{ control_plane_incident_observer_cpu_limit | to_json }}
    healthcheck:
      test:
        - CMD
        - python
        - -m
        - app.incident_observer
        - --healthcheck
      interval: 30s
      timeout: 10s
      start_period: 30s
      retries: 3
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
{% endif %}
