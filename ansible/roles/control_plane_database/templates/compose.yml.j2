services:
  postgres:
    image: {{ pilotage_database_image | to_json }}
    user: '999:999'
    restart: unless-stopped
    environment:
      POSTGRES_DB: moodle_pilotage
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD_FILE: /run/secrets/bootstrap_password
      POSTGRES_INITDB_ARGS: '--auth-host=scram-sha-256'
    ports:
      - {{ ('127.0.0.1:' ~ pilotage_database_port ~ ':5432') | to_json }}
    volumes:
      - {{ (pilotage_database_base_dir ~ '/data:/var/lib/postgresql/data') | to_json }}
      - {{ (pilotage_database_base_dir ~ '/secrets/bootstrap_password:/run/secrets/bootstrap_password:ro') | to_json }}
      - {{ (pilotage_database_base_dir ~ '/secrets/app_password:/run/secrets/app_password:ro') | to_json }}
      - {{ (pilotage_database_base_dir ~ '/init.sh:/docker-entrypoint-initdb.d/10-pilotage.sh:ro') | to_json }}
    read_only: true
    tmpfs:
      - /tmp:rw,noexec,nosuid,size=32m,uid=999,gid=999,mode=1777
      - /var/run/postgresql:rw,nosuid,size=8m,uid=999,gid=999,mode=0755
    cap_drop: [ALL]
    security_opt: ['no-new-privileges:true']
    mem_limit: {{ pilotage_database_memory_limit | to_json }}
    cpus: {{ pilotage_database_cpu_limit | to_json }}
    healthcheck:
      test: ['CMD', 'pg_isready', '-h', '127.0.0.1', '-U', 'postgres', '-d', 'moodle_pilotage']
      interval: 5s
      timeout: 3s
      start_period: 30s
      retries: 12
    logging:
      driver: json-file
      options: {max-size: '10m', max-file: '3'}
