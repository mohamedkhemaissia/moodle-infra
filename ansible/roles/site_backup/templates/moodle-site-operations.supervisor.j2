[program:{{ site_backup_supervisor_program }}]
command=/usr/local/sbin/moodle-site-operations-worker --interval-seconds {{ site_backup_interval_seconds }}
directory=/var/lib/moodle-site-operations
user=root
autostart=true
autorestart=unexpected
startsecs=2
startretries=5
stopsignal=TERM
stopwaitsecs=3700
stopasgroup=true
killasgroup=true
redirect_stderr=true
stdout_logfile=/var/log/supervisor/{{ site_backup_supervisor_program }}.log
stdout_logfile_maxbytes=2MB
stdout_logfile_backups=2
environment=PATH="/usr/sbin:/usr/bin:/sbin:/bin",LANG="C.UTF-8",PYTHONNOUSERSITE="1"
