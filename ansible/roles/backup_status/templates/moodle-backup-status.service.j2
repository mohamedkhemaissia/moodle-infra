[Unit]
Description=Suivi en lecture seule des sauvegardes Moodle
After=local-fs.target

[Service]
Type=oneshot
WorkingDirectory={{ backup_status_base_dir }}
ExecStart=/usr/bin/python3 -B -m backup_status.collector --marker {{ backup_status_marker }} --project {{ backup_status_project }} --max-age-hours {{ backup_status_max_age_hours }} --output {{ backup_status_output_dir }}/status.json
TimeoutStartSec=60
User=root
Group=root
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths={{ backup_status_output_dir }}
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
