#!/bin/sh
set -eu
umask 027
cd {{ (remediation_base_dir ~ '/code') | quote }}
database_config=''
if [ -f {{ (pilotage_database_config_dir ~ '/active') | quote }} ]; then
  database_config={{ (pilotage_database_config_dir ~ '/database.json') | quote }}
fi
service_token=''
if [ -f {{ (pilotage_database_config_dir ~ '/auth-active') | quote }} ]; then
  service_token={{ (pilotage_database_config_dir ~ '/worker-token') | quote }}
fi
exec /usr/bin/env -i PILOTAGE_DATABASE_CONFIG="$database_config" PILOTAGE_SERVICE_TOKEN_FILE="$service_token" PATH=/usr/bin:/bin LANG=C.UTF-8 PYTHONNOUSERSITE=1 \
  {{ remediation_python | quote }} -B -m remediation.run "$@"
