worker_processes 1;
pid /tmp/nginx.pid;
error_log stderr warn;

events { worker_connections 256; }

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /dev/stdout;
    server_tokens off;
    sendfile on;
    client_max_body_size 4k;
    client_body_temp_path /tmp/client_body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;

    server {
        listen 127.0.0.1:${DASHBOARD_PORT};
        server_name localhost;
        root /usr/share/nginx/html;
        index index.html;
        add_header X-Content-Type-Options nosniff always;

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Proto "";
        proxy_connect_timeout 2s;
        proxy_read_timeout 10s;
        proxy_send_timeout 5s;

        location = /healthz {
            access_log off;
            default_type text/plain;
            return 200 "ok\n";
        }

        location ~ "^/api/v1/(health|storage/health|metrics/(summary|applications|containers)|backups/((pilotage/)?summary|catalog)|auth/(status|session|events)|(forecasts|anomalies)/summary|anomalies/model|incidents(/summary|/[1-9][0-9]*(/events)?)?|decisions/(summary|policies|[1-9][0-9]*)|(diagnostics|remediations)(/summary|/[0-9a-f]{32})?)$" {
            limit_except GET { deny all; }
            proxy_pass ${API_ORIGIN};
            add_header Cache-Control no-store always;
            add_header X-Content-Type-Options nosniff always;
        }

        location ~ "^/api/v1/auth/(login|logout|password)$" {
            limit_except POST { deny all; }
            proxy_pass ${API_ORIGIN};
            add_header Cache-Control no-store always;
            add_header X-Content-Type-Options nosniff always;
        }

        location = /api/v1/users {
            limit_except GET POST { deny all; }
            proxy_pass ${API_ORIGIN};
            add_header Cache-Control no-store always;
            add_header X-Content-Type-Options nosniff always;
        }

        location = /api/v1/policies {
            limit_except GET POST { deny all; }
            proxy_pass ${API_ORIGIN};
            add_header Cache-Control no-store always;
            add_header X-Content-Type-Options nosniff always;
        }

        location = /api/v1/php-fpm/profiles {
            limit_except GET { deny all; }
            proxy_pass ${API_ORIGIN};
            add_header Cache-Control no-store always;
            add_header X-Content-Type-Options nosniff always;
        }

        location = /api/v1/policies/events {
            limit_except GET { deny all; }
            proxy_pass ${API_ORIGIN};
            add_header Cache-Control no-store always;
            add_header X-Content-Type-Options nosniff always;
        }

        location = /api/v1/policies/approvals {
            limit_except POST { deny all; }
            proxy_pass ${API_ORIGIN};
            add_header Cache-Control no-store always;
            add_header X-Content-Type-Options nosniff always;
        }

        location = /api/v1/recovery/requests {
            limit_except GET POST { deny all; }
            proxy_pass ${API_ORIGIN};
            add_header Cache-Control no-store always;
            add_header X-Content-Type-Options nosniff always;
        }

        location ~ "^/api/v1/recovery/requests/[0-9a-f]{32}$" {
            limit_except GET { deny all; }
            proxy_pass ${API_ORIGIN};
            add_header Cache-Control no-store always;
            add_header X-Content-Type-Options nosniff always;
        }

        location ~ "^/api/v1/recovery/requests/[0-9a-f]{32}/(approve|reject|cancel|execute)$" {
            limit_except POST { deny all; }
            proxy_pass ${API_ORIGIN};
            add_header Cache-Control no-store always;
            add_header X-Content-Type-Options nosniff always;
        }

        location ~ "^/api/v1/users/[1-9][0-9]*$" {
            limit_except PATCH { deny all; }
            proxy_pass ${API_ORIGIN};
            add_header Cache-Control no-store always;
            add_header X-Content-Type-Options nosniff always;
        }

        location /api/ { return 404; }
        location /assets/ {
            try_files $uri =404;
            add_header Cache-Control "public, max-age=31536000, immutable";
            add_header X-Content-Type-Options nosniff always;
        }
        location / {
            try_files $uri $uri/ /index.html;
            add_header Cache-Control no-store always;
            add_header X-Content-Type-Options nosniff always;
        }
    }
}
